<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Miau.Desktop.MainWindow"
 Title="MIAU" Width="1600" Height="980" MinWidth="1120" MinHeight="720" Background="#030303" FontFamily="Inter,Arial,sans-serif">
 <Window.Styles>
  <Style Selector="Button"><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="11,8"/><Setter Property="Background" Value="#121212"/><Setter Property="BorderBrush" Value="#252525"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="Button.nav"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,1"/></Style>
  <Style Selector="Button.nav.active"><Setter Property="Background" Value="#171717"/></Style>
  <Style Selector="Button.icon"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="17"/></Style>
  <Style Selector="Path.glyph"><Setter Property="Stroke" Value="#D7D7D7"/><Setter Property="StrokeThickness" Value="1.7"/><Setter Property="StrokeLineCap" Value="Round"/><Setter Property="StrokeJoin" Value="Round"/></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#858585"/></Style>
  <Style Selector="TextBlock.label"><Setter Property="Foreground" Value="#717171"/><Setter Property="FontSize" Value="11"/></Style>
  <Style Selector="Border.card"><Setter Property="Background" Value="#0B0B0B"/><Setter Property="BorderBrush" Value="#242424"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/></Style>
 </Window.Styles>
 <Grid ColumnDefinitions="276,*">
  <Border Grid.Column="0" Background="#080808" BorderBrush="#202020" BorderThickness="0,0,1,0">
   <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16,18,14,16">
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,0,2,16"><Image x:Name="SidebarLogo" Width="58" Height="22" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="MIAU" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0"/><TextBlock Grid.Column="2" Text="⌄" Foreground="#777" VerticalAlignment="Center"/></Grid>
    <StackPanel Grid.Row="1" Spacing="2">
     <Button Classes="nav active" Click="NewTask" Height="38"><StackPanel Orientation="Horizontal" Spacing="11"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Classes="glyph" Data="M5,5 L19,5 L19,17 L9,17 L5,21 Z M12,8 L12,14 M9,11 L15,11"/></Canvas></Viewbox><TextBlock Text="Novo chat"/></StackPanel></Button>
     <Button Classes="nav" Click="ShowConversations" Height="38"><StackPanel Orientation="Horizontal" Spacing="11"><TextBlock Text="◷" FontSize="16"/><TextBlock Text="Conversas"/></StackPanel></Button>
     <Button Classes="nav" Click="OpenWorkspace" Height="38"><StackPanel Orientation="Horizontal" Spacing="11"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Classes="glyph" Data="M3,7 L10,7 L12,9 L21,9 L19,19 L5,19 Z"/></Canvas></Viewbox><TextBlock Text="Projetos"/></StackPanel></Button>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="8,25,6,0" Spacing="8"><TextBlock Classes="label" Text="PROJETO ATUAL"/><Border Background="#151515" CornerRadius="8" Padding="10,9"><StackPanel Orientation="Horizontal" Spacing="9"><TextBlock Text="▱"/><TextBlock x:Name="WorkspaceText" Text="Nenhum projeto aberto" TextWrapping="Wrap" MaxWidth="190"/></StackPanel></Border></StackPanel>
    <StackPanel Grid.Row="3" Margin="8,26,4,0" Spacing="10"><TextBlock Classes="label" Text="ATALHOS"/><TextBlock Text="Evolução do MIAU" Foreground="#A7A7A7"/><TextBlock Text="Execuções recentes" Foreground="#A7A7A7"/><TextBlock Text="Alterações do projeto" Foreground="#A7A7A7"/></StackPanel>
    <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" Margin="4,12,2,0"><Border Width="27" Height="27" Background="#F2A900" CornerRadius="14"><TextBlock Text="DM" FontSize="10" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="9,0"><TextBlock Text="Djalma Martins" FontSize="12"/><TextBlock Classes="muted" Text="Ambiente local" FontSize="10"/></StackPanel><TextBlock Grid.Column="2" Text="⚙" Foreground="#888" VerticalAlignment="Center"/></Grid>
   </Grid>
  </Border>
  <Grid Grid.Column="1" RowDefinitions="56,*,Auto" Background="#030303">
   <Border BorderBrush="#1D1D1D" BorderThickness="0,0,0,1" Padding="18,0"><Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="▱"/><TextBlock Text="MIAU Desktop" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><TextBlock x:Name="StatusText" Classes="muted" Text="● qwen2.5-coder:7b (local)" VerticalAlignment="Center"/><Button Classes="nav" Content="Limpar" Click="NewTask"/></StackPanel></Grid></Border>
   <Grid Grid.Row="1">
    <Grid Margin="0,0,344,0">
     <StackPanel x:Name="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center" Width="650"><Image x:Name="WelcomeLogo" Width="220" Height="78" Stretch="Uniform" Margin="0,0,0,24"/><TextBlock Text="O que vamos construir?" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Classes="muted" Text="Seu agente de desenvolvimento local, privado e orientado por evidências." FontSize="15" HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel>
     <ScrollViewer x:Name="Scroller" IsVisible="False" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Thread" MaxWidth="760" HorizontalAlignment="Center" Margin="28,34,28,120" Spacing="14"/></ScrollViewer>
    </Grid>
    <Border Classes="card" Width="306" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,28,20,0" Padding="15">
     <ScrollViewer MaxHeight="700" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="13">
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Ambiente" Classes="muted" FontSize="13"/><TextBlock Grid.Column="1" Text="＋" Foreground="#777"/></Grid>
      <Grid ColumnDefinitions="Auto,*,Auto"><TextBlock Text="◫"/><TextBlock Grid.Column="1" Text="Alterações" Margin="10,0"/><TextBlock Grid.Column="2" x:Name="ChangeSummary" Text="Nenhuma" Foreground="#51D47A" FontSize="11"/></Grid>
      <Grid ColumnDefinitions="Auto,*"><TextBlock Text="▱"/><TextBlock Grid.Column="1" Text="Local" Margin="10,0"/></Grid><Grid ColumnDefinitions="Auto,*"><TextBlock Text="⑂"/><TextBlock Grid.Column="1" Text="rebuild/desktop-v1" Margin="10,0"/></Grid>
      <Separator Background="#242424"/><TextBlock Text="Agente" Classes="muted" FontSize="12"/><TextBlock Text="MIAU1-Coder v0" FontWeight="SemiBold"/><TextBlock Text="Modelo: qwen2.5-coder:7b" Classes="muted" FontSize="11"/><TextBlock x:Name="AgentIdText" Classes="muted" FontSize="10" TextWrapping="Wrap"/>
      <Grid ColumnDefinitions="*,Auto"><ToggleSwitch x:Name="AutonomousToggle" Content="Modo autônomo" Checked="AutonomousChanged" Unchecked="AutonomousChanged"/><CheckBox Grid.Column="1" x:Name="StopAfterTaskCheck" Content="Parar" IsVisible="False"/></Grid><TextBlock x:Name="CurrentJobText" Classes="muted" Text="Aguardando trabalho" TextWrapping="Wrap"/><Button Content="Evolution Dashboard" Click="OpenEvolutionDashboard"/>
      <Border Classes="card" Padding="10"><StackPanel Spacing="7"><TextBlock Text="AUTOAPERFEIÇOAMENTO" Classes="label"/><Grid ColumnDefinitions="*,Auto"><ToggleSwitch x:Name="TrainingToggle" Content="Treino" Checked="TrainingChanged" Unchecked="TrainingChanged"/><TextBlock Grid.Column="1" x:Name="TrainingStatusText" Text="Desativado" Classes="muted" FontSize="10"/></Grid><ToggleSwitch x:Name="SelfRepairToggle" Content="Auto-reparo" Checked="SelfRepairChanged" Unchecked="SelfRepairChanged"/><Grid ColumnDefinitions="*,*" ColumnSpacing="6"><Button Content="Executar" Click="RunTrainingCycle"/><Button Grid.Column="1" Content="Reparos" Click="ReviewRepairs"/></Grid></StackPanel></Border>
      <TabControl TabStripPlacement="Top"><TabItem Header="Execução"><StackPanel Margin="0,10,0,0" Spacing="8"><Grid ColumnDefinitions="Auto,*,Auto,Auto"><Ellipse x:Name="ExecutionDot" Width="8" Height="8" Fill="#777"/><TextBlock Grid.Column="1" x:Name="ExecutionStateText" Text="Aguardando" Classes="muted" FontSize="11" Margin="7,0"/><TextBlock Grid.Column="2" x:Name="ExecutionElapsedText" Classes="muted" FontSize="10"/><Button Grid.Column="3" x:Name="CopyExecutionButton" Content="⧉" Padding="5,1" Background="Transparent" Click="CopyExecution"/></Grid><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"><TextBlock x:Name="PhaseUnderstand" Text="○ Entender"/><TextBlock Grid.Column="1" x:Name="PhaseInspect" Text="○ Inspecionar"/><TextBlock Grid.Row="1" x:Name="PhasePlan" Text="○ Planejar"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="PhaseEdit" Text="○ Editar"/><TextBlock Grid.Row="2" x:Name="PhaseVerify" Text="○ Verificar"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="PhaseTest" Text="○ Testar"/></Grid><ScrollViewer x:Name="ActivityScroller" Height="195"><StackPanel x:Name="ActivityFeed" Spacing="6"><TextBlock Classes="muted" Text="Aguardando uma tarefa…" TextWrapping="Wrap"/></StackPanel></ScrollViewer><Grid ColumnDefinitions="*,*" ColumnSpacing="6"><Button Content="Diagnóstico" Click="RunDiagnostics"/><Button Grid.Column="1" Content="Benchmark" Click="RunBenchmark"/></Grid></StackPanel></TabItem><TabItem Header="Diff"><Grid RowDefinitions="*,Auto" Margin="0,10,0,0"><TextBox x:Name="DiffBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="245" FontFamily="Menlo,Consolas,monospace" FontSize="9" Background="#050505"/><Button Grid.Row="1" Content="Atualizar diff" Margin="0,8,0,0" Click="RefreshDiff"/></Grid></TabItem></TabControl>
     </StackPanel></ScrollViewer>
    </Border>
   </Grid>
   <Border Grid.Row="2" Classes="card" MaxWidth="740" MinWidth="520" HorizontalAlignment="Center" Margin="0,10,344,22" Padding="12"><Grid RowDefinitions="Auto,Auto,Auto"><TextBlock x:Name="AttachmentText" Classes="muted" FontSize="11" IsVisible="False" TextWrapping="Wrap" Margin="4,0,4,8"/><TextBox Grid.Row="1" x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Background="Transparent" BorderThickness="0" Padding="4" Watermark="Peça qualquer coisa ao MIAU..."/><Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,8,0,0"><Button Classes="icon" Background="Transparent" ToolTip.Tip="Adicionar arquivo" Click="AddAttachment"><TextBlock Text="＋" FontSize="18"/></Button><Button Grid.Column="1" Classes="icon" Background="Transparent" ToolTip.Tip="Adicionar vários arquivos" Click="AddLibrary"><TextBlock Text="▱"/></Button><TextBlock Grid.Column="2" Classes="muted" Text="Acesso local completo" VerticalAlignment="Center" Margin="9,0" FontSize="11"/><TextBlock Grid.Column="3" Classes="muted" Text="qwen2.5-coder:7b" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11"/><Button Grid.Column="4" x:Name="SendButton" Classes="icon" Background="#3478F6" BorderThickness="0" ToolTip.Tip="Enviar" Click="Send"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Stroke="White" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Data="M12,19 L12,5 M6,11 L12,5 L18,11"/></Canvas></Viewbox></Button><Button Grid.Column="4" x:Name="StopButton" Classes="icon" IsVisible="False" ToolTip.Tip="Parar" Click="Stop"><Border Width="10" Height="10" Background="#EEE" CornerRadius="2"/></Button></Grid></Grid></Border>
  </Grid>
 </Grid>
</Window>
