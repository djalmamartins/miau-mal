<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Miau.Desktop.MainWindow" Title="MIAU" Width="1180" Height="760" MinWidth="850" MinHeight="560">
<Grid ColumnDefinitions="230,*" RowDefinitions="*">
 <Border Grid.Column="0" BorderBrush="#303030" BorderThickness="0,0,1,0" Padding="14">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
   <TextBlock Text="🐱  MIAU" FontSize="20" FontWeight="SemiBold"/>
   <Button Grid.Row="1" Margin="0,18,0,12" Content="+ Nova tarefa" Click="NewTask"/>
   <StackPanel Grid.Row="2"><TextBlock Text="AGENTE LOCAL" Opacity=".55" FontSize="11"/><TextBlock Text="qwen2.5-coder:7b" Margin="0,6,0,0"/><TextBlock x:Name="WorkspaceText" Text="Nenhum projeto aberto" TextWrapping="Wrap" Margin="0,14,0,0" Opacity=".7"/></StackPanel>
   <Button Grid.Row="3" Content="Abrir projeto…" Click="OpenWorkspace"/>
  </Grid>
 </Border>
 <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
  <Border Padding="18,12" BorderBrush="#303030" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Coding Agent" FontSize="16" FontWeight="SemiBold"/><TextBlock Grid.Column="1" x:Name="StatusText" Text="Ollama local" Opacity=".6"/></Grid></Border>
  <ScrollViewer Grid.Row="1" x:Name="Scroller"><StackPanel x:Name="Thread" Margin="28,24" Spacing="18"><TextBlock Text="O que vamos construir?" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Abra um projeto e peça ao MIAU para analisar, criar ou corrigir código. As ferramentas são executadas localmente." Opacity=".65" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
  <Border Grid.Row="2" Margin="20" Padding="10" CornerRadius="8" BorderBrush="#454545" BorderThickness="1"><Grid RowDefinitions="Auto,Auto">
   <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" Watermark="Peça ao MIAU para trabalhar no projeto…"/>
   <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0"><TextBlock Text="Arquivos e comandos locais" Opacity=".5" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="StopButton" Content="Parar" IsEnabled="False" Click="Stop"/><Button Grid.Column="2" x:Name="SendButton" Content="Enviar ↑" Margin="8,0,0,0" Click="Send"/></Grid>
  </Grid></Border>
 </Grid>
</Grid></Window>