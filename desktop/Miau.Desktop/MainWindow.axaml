<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="Miau.Desktop.MainWindow" Title="MIAU" Width="1536" Height="960" MinWidth="1100" MinHeight="700"
 Background="#000000">
<Window.Styles>
 <Style Selector="Button"><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12,9"/></Style>
 <Style Selector="Button.nav"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="0,2"/></Style>
 <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#969DA5"/></Style>
 <Style Selector="Border.card"><Setter Property="Background" Value="#151A1F"/><Setter Property="BorderBrush" Value="#2B3238"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/></Style>
 <Style Selector="Button.icon"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="17"/><Setter Property="FontSize" Value="17"/></Style>
</Window.Styles>
<Grid ColumnDefinitions="286,*,310">
 <Border Grid.Column="0" Background="#0B0E11" BorderBrush="#282E34" BorderThickness="0,0,1,0">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="22">
   <StackPanel Orientation="Horizontal" Spacing="14">
    <Border Width="70" Height="25" Background="#000000" ClipToBounds="True" VerticalAlignment="Center">
     <Canvas Width="70" Height="25">
      <Image x:Name="SidebarLogo" Width="129" Height="111" Stretch="Fill" Canvas.Left="-29" Canvas.Top="-64"/>
     </Canvas>
    </Border>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="MIAU" FontSize="27" FontWeight="Bold"/><TextBlock Classes="muted" Text="Seu agente local"/></StackPanel>
   </StackPanel>
   <Button Grid.Row="1" Margin="0,25,0,18" Height="48" Content="＋  Nova conversa" Click="NewTask"/>
   <StackPanel Grid.Row="2">
    <Button Classes="nav" Content="▣   Conversas"/><Button Classes="nav" Content="▱   Projetos" Click="OpenWorkspace"/>
    
   </StackPanel>
   <StackPanel Grid.Row="3" Margin="6,28,0,0"><TextBlock Classes="muted" Text="PROJETO ATUAL" FontSize="11"/><TextBlock x:Name="WorkspaceText" Text="Nenhum projeto aberto" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
   <StackPanel Grid.Row="4"><Separator/><TextBlock Text="DM   Djalma Martins" Margin="4,14,0,0"/></StackPanel>
  </Grid>
 </Border>

 <Grid Grid.Column="1" RowDefinitions="72,*,Auto">
  <Border BorderBrush="#282E34" BorderThickness="0,0,0,1" Padding="30,0">
   <Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="MIAU ⌄" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Classes="muted" Text="● qwen2.5-coder:7b (local)" FontSize="12"/></StackPanel><Button Grid.Column="1" Classes="nav" Content="Limpar" Click="NewTask"/></Grid>
  </Border>
  <Grid Grid.Row="1">
   <StackPanel x:Name="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center" Width="790">
    <Border Width="190" Height="55" Background="#000000" ClipToBounds="True" HorizontalAlignment="Center" Margin="0,0,0,28">
     <Canvas Width="190" Height="55">
      <Image x:Name="WelcomeLogo" Width="350" Height="303" Stretch="Fill" Canvas.Left="-80" Canvas.Top="-174"/>
     </Canvas>
    </Border>
    <TextBlock Text="Como posso ajudar?" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
    <TextBlock Classes="muted" Text="Codifique. Planeje. Analise. Faça mais com o MIAU." FontSize="18" HorizontalAlignment="Center" Margin="0,10,0,0"/>
   </StackPanel>
   <ScrollViewer x:Name="Scroller" IsVisible="False" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Thread" Margin="46,30" Spacing="14"/></ScrollViewer>
  </Grid>
  <Border Grid.Row="2" Margin="28,12,28,24" Padding="14" CornerRadius="18" Background="#12171C" BorderBrush="#2A3138" BorderThickness="1">
   <Grid RowDefinitions="Auto,Auto,Auto">
    <TextBlock x:Name="AttachmentText" Classes="muted" FontSize="11" IsVisible="False" TextWrapping="Wrap" Margin="4,0,4,8"/>
    <TextBox Grid.Row="1" x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="82" Background="#0D1115" BorderBrush="#242B32" BorderThickness="1" CornerRadius="10" Padding="12" Watermark="Digite sua mensagem..."/>
    <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,11,0,0">
     <Button Classes="icon" Content="＋" ToolTip.Tip="Adicionar arquivo ou imagem" Click="AddAttachment"/>
     <Button Grid.Column="1" Classes="icon" Content="▧" Margin="8,0,0,0" ToolTip.Tip="Adicionar vários arquivos" Click="AddLibrary"/>
     <TextBlock Grid.Column="2" Classes="muted" Text="Agente local" VerticalAlignment="Center" Margin="12,0"/>
     <Button Grid.Column="3" x:Name="SendButton" Classes="icon" Content="➜" ToolTip.Tip="Enviar" Click="Send"/>
     <Button Grid.Column="3" x:Name="StopButton" Classes="icon" Content="■" ToolTip.Tip="Parar" IsVisible="False" Click="Stop"/>
    </Grid>
   </Grid>
  </Border>
 </Grid>

 <Border Grid.Column="2" Background="#111519" BorderBrush="#282E34" BorderThickness="1,0,0,0">
  <ScrollViewer><StackPanel Margin="22" Spacing="12">
   <TextBlock Text="EXECUÇÃO" FontWeight="SemiBold"/>
   <TextBlock Classes="muted" Text="Agente local • qwen2.5-coder:7b" TextWrapping="Wrap"/>
   <TextBlock x:Name="AgentIdText" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
   <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
    <ToggleSwitch x:Name="AutonomousToggle" Content="Modo autônomo" Checked="AutonomousChanged" Unchecked="AutonomousChanged"/>
    <CheckBox Grid.Column="1" x:Name="StopAfterTaskCheck" Content="Parar após tarefa" VerticalAlignment="Center" IsVisible="False"/>
   </Grid>
   <TextBlock x:Name="CurrentJobText" Classes="muted" Text="Aguardando trabalho" TextWrapping="Wrap"/>
   <Border Background="#0B0E11" BorderBrush="#282E34" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4,0,4">
    <ScrollViewer Height="260" VerticalScrollBarVisibility="Auto">
     <StackPanel x:Name="ActivityFeed" Spacing="7">
      <TextBlock Classes="muted" Text="Aguardando uma tarefa…" TextWrapping="Wrap"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <Separator Margin="0,12,0,4"/><TextBlock Text="ALTERAÇÕES" FontWeight="SemiBold"/><TextBlock x:Name="ChangeSummary" Classes="muted" Text="Nenhuma alteração" TextWrapping="Wrap"/>
   <TextBox x:Name="DiffBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="220" FontFamily="Menlo,Consolas,monospace" FontSize="10" Background="#0B0E11"/><Button Content="Atualizar diff" Click="RefreshDiff"/>
  </StackPanel></ScrollViewer>
 </Border>
</Grid></Window>