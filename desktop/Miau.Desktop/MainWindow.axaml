<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="Miau.Desktop.MainWindow" Title="MIAU" Width="1536" Height="960" MinWidth="1100" MinHeight="700"
 Background="#050607">
<Window.Styles>
 <Style Selector="Button"><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="12,9"/></Style>
 <Style Selector="Button.nav"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="0,2"/></Style>
 <Style Selector="Button.navIcon"><Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="CornerRadius" Value="6"/></Style>
 <Style Selector="Path.navGlyph"><Setter Property="Stroke" Value="#E8EAED"/><Setter Property="StrokeThickness" Value="1.7"/><Setter Property="StrokeLineCap" Value="Round"/><Setter Property="StrokeJoin" Value="Round"/></Style>
 <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#969DA5"/></Style>
 <Style Selector="Border.card"><Setter Property="Background" Value="#0D0F11"/><Setter Property="BorderBrush" Value="#24282D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/></Style>
 <Style Selector="Button.icon"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="17"/><Setter Property="FontSize" Value="17"/></Style>
</Window.Styles>
<Grid ColumnDefinitions="286,*,340">
 <Border Grid.Column="0" Background="#090A0C" BorderBrush="#202328" BorderThickness="0,0,1,0">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="22">
   <StackPanel Orientation="Horizontal" Spacing="14">
    <Border Width="70" Height="32" Background="Transparent" VerticalAlignment="Center">
     <Canvas Width="70" Height="25">
      <Image x:Name="SidebarLogo" IsVisible="False"/><Path Fill="#FFC400" Data="M 6,13 C 13,5 25,5 31,13 C 25,21 13,21 6,13 Z"/><Ellipse Fill="#090A0C" Width="8" Height="13" Canvas.Left="18" Canvas.Top="6"/><Path Fill="#FFC400" Data="M 39,13 C 45,5 57,5 64,13 C 57,21 45,21 39,13 Z"/><Ellipse Fill="#090A0C" Width="8" Height="13" Canvas.Left="45" Canvas.Top="6"/>
     </Canvas>
    </Border>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="MIAU" FontSize="27" FontWeight="Bold"/><TextBlock Classes="muted" Text="Seu agente local"/></StackPanel>
   </StackPanel>
   <Button Grid.Row="1" Margin="0,25,0,18" Height="44" Click="NewTask" HorizontalContentAlignment="Left" Padding="12,0">
    <StackPanel Orientation="Horizontal" Spacing="10">
     <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Classes="navGlyph" Data="M12,5 L12,19 M5,12 L19,12"/></Canvas></Viewbox>
     <TextBlock Text="Nova conversa" VerticalAlignment="Center"/>
    </StackPanel>
   </Button>
   <StackPanel Grid.Row="2" Spacing="4">
    <Button Classes="nav" Click="ShowConversations" Height="40" Padding="8,0">
     <StackPanel Orientation="Horizontal" Spacing="12">
      <Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Classes="navGlyph" Data="M4,5 L20,5 L20,17 L8,17 L4,21 Z"/></Canvas></Viewbox>
      <TextBlock Text="Conversas" VerticalAlignment="Center"/>
     </StackPanel>
    </Button>
    <Button Classes="nav" Click="OpenWorkspace" Height="40" Padding="8,0">
     <StackPanel Orientation="Horizontal" Spacing="12">
      <Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Classes="navGlyph" Data="M3,7 L10,7 L12,9 L21,9 L19,19 L5,19 Z"/></Canvas></Viewbox>
      <TextBlock Text="Projetos" VerticalAlignment="Center"/>
     </StackPanel>
    </Button>
   </StackPanel>
   <StackPanel Grid.Row="3" Margin="6,28,0,0"><TextBlock Classes="muted" Text="PROJETO ATUAL" FontSize="11"/><TextBlock x:Name="WorkspaceText" Text="Nenhum projeto aberto" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
   <StackPanel Grid.Row="4"><Separator/><TextBlock Text="DM   Djalma Martins" Margin="4,14,0,0"/></StackPanel>
  </Grid>
 </Border>

 <Grid Grid.Column="1" RowDefinitions="72,*,Auto">
  <Border Background="#050607" BorderBrush="#202328" BorderThickness="0,0,0,1" Padding="30,0">
   <Grid ColumnDefinitions="*,Auto">
    <StackPanel VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal" Spacing="7">
      <TextBlock Text="MIAU" FontSize="19" FontWeight="SemiBold"/>
      <Viewbox Width="10" Height="10" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Classes="navGlyph" Data="M7,9 L12,14 L17,9"/></Canvas></Viewbox>
     </StackPanel>
     <TextBlock x:Name="StatusText" Classes="muted" Text="● qwen2.5-coder:7b (local)" FontSize="12"/>
    </StackPanel>
    <Button Grid.Column="1" Classes="nav" Content="Limpar" Click="NewTask"/>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <StackPanel x:Name="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center" Width="790">
    <Border Width="190" Height="55" Background="Transparent" HorizontalAlignment="Center" Margin="0,0,0,28">
     <Canvas Width="190" Height="55">
      <Image x:Name="WelcomeLogo" IsVisible="False"/><Path Fill="#FFC400" Data="M 32,25 C 46,8 72,8 85,25 C 72,42 46,42 32,25 Z"/><Ellipse Fill="#090A0C" Width="15" Height="25" Canvas.Left="58" Canvas.Top="12"/><Path Fill="#FFC400" Data="M 105,25 C 118,8 144,8 158,25 C 144,42 118,42 105,25 Z"/><Ellipse Fill="#090A0C" Width="15" Height="25" Canvas.Left="118" Canvas.Top="12"/>
     </Canvas>
    </Border>
    <TextBlock Text="Como posso ajudar?" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
    <TextBlock Classes="muted" Text="Codifique. Planeje. Analise. Faça mais com o MIAU." FontSize="18" HorizontalAlignment="Center" Margin="0,10,0,0"/>
   </StackPanel>
   <ScrollViewer x:Name="Scroller" IsVisible="False" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Thread" Margin="46,30" Spacing="14"/></ScrollViewer>
  </Grid>
  <Border Grid.Row="2" Margin="28,12,28,24" Padding="14" CornerRadius="14" Background="#0D0F11" BorderBrush="#24282D" BorderThickness="1">
   <Grid RowDefinitions="Auto,Auto,Auto">
    <TextBlock x:Name="AttachmentText" Classes="muted" FontSize="11" IsVisible="False" TextWrapping="Wrap" Margin="4,0,4,8"/>
    <TextBox Grid.Row="1" x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="82" Background="#090B0D" BorderBrush="#24282D" BorderThickness="1" CornerRadius="10" Padding="12" Watermark="Digite sua mensagem..."/>
    <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,11,0,0">
     <Button Classes="icon" ToolTip.Tip="Adicionar arquivo ou imagem" Click="AddAttachment">
      <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Classes="navGlyph" Data="M12,5 L12,19 M5,12 L19,12"/></Canvas></Viewbox>
     </Button>
     <Button Grid.Column="1" Classes="icon" Margin="8,0,0,0" ToolTip.Tip="Adicionar vários arquivos" Click="AddLibrary">
      <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Classes="navGlyph" Data="M4,6 L10,6 L12,8 L20,8 L20,19 L4,19 Z"/></Canvas></Viewbox>
     </Button>
     <TextBlock Grid.Column="2" Classes="muted" Text="Agente local" VerticalAlignment="Center" Margin="12,0"/>
     <Button Grid.Column="3" x:Name="SendButton" Classes="icon" Background="#3B82F6" CornerRadius="17" ToolTip.Tip="Enviar" Click="Send">
      <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Stroke="White" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Data="M12,19 L12,5 M6,11 L12,5 L18,11"/></Canvas></Viewbox>
     </Button>
     <Button Grid.Column="3" x:Name="StopButton" Classes="icon" ToolTip.Tip="Parar" IsVisible="False" Click="Stop">
      <Border Width="10" Height="10" Background="#E8EAED" CornerRadius="2"/>
     </Button>
    </Grid>
   </Grid>
  </Border>
 </Grid>

 <Border Grid.Column="2" Background="#090A0C" BorderBrush="#202328" BorderThickness="1,0,0,0">
  <Grid RowDefinitions="Auto,Auto,*" Margin="20">
   <StackPanel Spacing="6">
    <TextBlock Text="MIAU1-Coder v0" FontWeight="SemiBold"/>
    <TextBlock Classes="muted" Text="Modelo: qwen2.5-coder:7b" TextWrapping="Wrap"/>
    <TextBlock x:Name="AgentIdText" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
    <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
     <ToggleSwitch x:Name="AutonomousToggle" Content="Modo autônomo" Checked="AutonomousChanged" Unchecked="AutonomousChanged"/>
     <CheckBox Grid.Column="1" x:Name="StopAfterTaskCheck" Content="Parar após tarefa" VerticalAlignment="Center" IsVisible="False"/>
    </Grid>
    <TextBlock x:Name="CurrentJobText" Classes="muted" Text="Aguardando trabalho" TextWrapping="Wrap"/>
   </StackPanel>

   <TabControl Grid.Row="1" Margin="0,14,0,0" TabStripPlacement="Top">
    <TabItem Header="Execução" FontSize="13" Padding="10,6">
     <StackPanel Margin="0,12,0,0" Spacing="10">
      <Border Background="#050607" BorderBrush="#24282D" BorderThickness="1" CornerRadius="8" Padding="10">
       <Grid RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,9">
         <Ellipse x:Name="ExecutionDot" Width="9" Height="9" Fill="#7D858D" VerticalAlignment="Center"/>
         <TextBlock Grid.Column="1" x:Name="ExecutionStateText" Text="Aguardando" Classes="muted" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
         <TextBlock Grid.Column="2" x:Name="ExecutionElapsedText" Text="" Classes="muted" FontSize="10" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,9">
         <TextBlock x:Name="PhaseUnderstand" Text="○ Entender"/><TextBlock Grid.Column="1" x:Name="PhaseInspect" Text="○ Inspecionar"/>
         <TextBlock Grid.Row="1" x:Name="PhasePlan" Text="○ Planejar"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="PhaseEdit" Text="○ Editar"/>
         <TextBlock Grid.Row="2" x:Name="PhaseVerify" Text="○ Verificar"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="PhaseTest" Text="○ Testar"/>
        </Grid>
        <ScrollViewer Grid.Row="2" x:Name="ActivityScroller" Height="390" VerticalScrollBarVisibility="Auto">
         <StackPanel x:Name="ActivityFeed" Spacing="7"><TextBlock Classes="muted" Text="Aguardando uma tarefa…" TextWrapping="Wrap"/></StackPanel>
        </ScrollViewer>
       </Grid>
      </Border>
      <Button Content="Executar diagnóstico" HorizontalAlignment="Stretch" Click="RunDiagnostics"/>
     </StackPanel>
    </TabItem>
    <TabItem Header="Alterações" FontSize="13" Padding="10,6">
     <Grid RowDefinitions="Auto,*,Auto" Margin="0,12,0,0">
      <TextBlock x:Name="ChangeSummary" Classes="muted" Text="Nenhuma alteração" TextWrapping="Wrap" Margin="2,0,2,10"/>
      <TextBox Grid.Row="1" x:Name="DiffBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="420" FontFamily="Menlo,Consolas,monospace" FontSize="10" Background="#050607"/>
      <Button Grid.Row="2" Content="Atualizar diff" Margin="0,10,0,0" HorizontalAlignment="Stretch" ToolTip.Tip="Atualizar e conferir as alterações atuais do workspace no Git" Click="RefreshDiff"/>
     </Grid>
    </TabItem>
   </TabControl>
  </Grid>
 </Border>
</Grid></Window>
